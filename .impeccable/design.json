  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "日色膠囊主按鈕，如「導航」。",
      "html": "<button class=\"ds-btn ds-btn--day\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l18-8-8 18-2-8-8-2z\"/></svg>導航</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border-radius:99px;font:700 14.5px/1 var(--round,\"Zen Maru\",sans-serif);border:1.5px solid #E8E2D8;color:#2A2622;background:#fff;cursor:pointer;transition:background-color .2s,border-color .2s,color .2s}.ds-btn--day{background:var(--day,#4F5E2C);border-color:var(--day,#4F5E2C);color:#fff}.ds-btn--day:hover{background:#2A2622;border-color:#2A2622}.ds-btn:focus-visible{outline:3px solid #2A2622;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "白底外框膠囊，如「撥打電話」。",
      "html": "<button class=\"ds-btn-o\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/></svg>撥打電話</button>",
      "css": ".ds-btn-o{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border-radius:99px;font:700 14.5px/1 var(--round,\"Zen Maru\",sans-serif);border:1.5px solid #E8E2D8;color:#2A2622;background:#fff;cursor:pointer;transition:border-color .2s}.ds-btn-o:hover{border-color:#2A2622}.ds-btn-o:focus-visible{outline:3px solid #2A2622;outline-offset:2px}"
    },
    {
      "name": "Day Strip",
      "kind": "nav",
      "refersTo": "day-chip",
      "description": "8 格和風沉穩色階日期鈕（白字），選中者加墨環。",
      "html": "<div class=\"ds-days\"><button class=\"ds-day\" style=\"--c:#5F7036;--ci:#FFFFFF\"><b>1</b><small>11/24</small></button><button class=\"ds-day is-on\" style=\"--c:#6E7A3A;--ci:#FFFFFF\"><b>2</b><small>11/25</small></button><button class=\"ds-day\" style=\"--c:#7D7436;--ci:#FFFFFF\"><b>3</b><small>11/26</small></button><button class=\"ds-day\" style=\"--c:#8F6936;--ci:#FFFFFF\"><b>4</b><small>11/27</small></button><button class=\"ds-day\" style=\"--c:#8E5534;--ci:#FFFFFF\"><b>5</b><small>11/28</small></button><button class=\"ds-day\" style=\"--c:#844536;--ci:#FFFFFF\"><b>6</b><small>11/29</small></button><button class=\"ds-day\" style=\"--c:#74393F;--ci:#FFFFFF\"><b>7</b><small>11/30</small></button><button class=\"ds-day\" style=\"--c:#5C3B50;--ci:#FFFFFF\"><b>8</b><small>12/01</small></button></div>",
      "css": ".ds-days{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px}.ds-day{appearance:none;border:0;background:var(--c);color:var(--ci);border-radius:8px;min-height:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-day b{font:900 21px/1 var(--round,\"Zen Maru\",sans-serif)}.ds-day small{font-size:10.5px;font-weight:700;opacity:.85}.ds-day:hover{transform:translateY(-2px)}.ds-day.is-on{box-shadow:0 0 0 2px #fff,0 0 0 4.5px #2A2622}.ds-day:focus-visible{outline:3px solid #2A2622;outline-offset:2px}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip-day",
      "description": "日色膠囊、安靜膠囊與虛線「待填」。",
      "html": "<span class=\"ds-chip\">Day 2・鶯</span> <span class=\"ds-chip ds-chip--quiet\">阿蘇 住宿</span> <span class=\"ds-todo\">待填</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;padding:4px 11px;border-radius:99px;background:var(--day-soft,#EDEFE3);color:var(--day,#4F5E2C);font:700 12.5px/1.2 var(--round,\"Zen Maru\",sans-serif)}.ds-chip--quiet{background:#F3EFEA;color:#3E3831}.ds-todo{display:inline-block;padding:0 10px;border:1.5px dashed #A79F94;border-radius:99px;color:#6B6258;font-size:12px;line-height:1.75;font-weight:700}"
    },
    {
      "name": "Stop Row",
      "kind": "custom",
      "refersTo": "stop-photo",
      "description": "2px 墨線下的景點列：圓角小照片、日色編號、車程靠右。",
      "html": "<ol class=\"ds-stops\"><li class=\"ds-stop\"><span class=\"ds-stop__img\"><span class=\"ds-stop__ph\"></span><span class=\"ds-stop__n\">1</span></span><span class=\"ds-stop__t\"><b>白川水源</b></span><span class=\"ds-stop__mv\">車程 30 分</span></li><li class=\"ds-stop\"><span class=\"ds-stop__img\"><span class=\"ds-stop__ph\"></span><span class=\"ds-stop__n\">2</span></span><span class=\"ds-stop__t\"><b>高千穗神社</b></span><span class=\"ds-stop__mv\">車程 75 分</span></li></ol>",
      "css": ".ds-stops{list-style:none;margin:0;padding:0;border-top:2px solid #2A2622}.ds-stop{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:12px;align-items:center;padding:12px 0;min-height:76px;border-bottom:1px solid #E8E2D8}.ds-stop__img{position:relative;width:56px;height:56px}.ds-stop__ph{display:block;width:56px;height:56px;border-radius:12px;background:#A79F94}.ds-stop__n{position:absolute;left:-5px;top:-5px;min-width:22px;height:22px;border-radius:99px;background:var(--day,#4F5E2C);color:#fff;font:900 12px/22px var(--round,\"Zen Maru\",sans-serif);text-align:center;box-shadow:0 0 0 2px #fff}.ds-stop__t b{font:900 17px/1.35 var(--round,\"Zen Maru\",sans-serif)}.ds-stop:hover .ds-stop__t b{color:var(--day,#4F5E2C)}.ds-stop__mv{font-size:12.5px;font-weight:700;color:var(--day,#4F5E2C);white-space:nowrap;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Lodge Card",
      "kind": "card",
      "refersTo": "lodge-card",
      "description": "日色淡底卡頭的住宿卡，含可收合訂房資訊。",
      "html": "<article class=\"ds-lodge\"><header class=\"ds-lodge__head\"><b>熊本阿蘇萬楓酒店</b><small>11/24 入住 – 11/26 退房・2 晚</small></header><div class=\"ds-lodge__body\"><dl><dt>電話</dt><dd>+81 967-34-0515</dd><dt>訂房編號</dt><dd><span class=\"ds-todo\">待填</span></dd></dl></div></article>",
      "css": ".ds-lodge{border:1px solid #E8E2D8;border-radius:16px;background:#fff;overflow:hidden}.ds-lodge__head{display:grid;gap:2px;padding:16px;background:var(--day-soft,#EDEFE3)}.ds-lodge__head b{font:900 18px/1.3 var(--round,\"Zen Maru\",sans-serif)}.ds-lodge__head small{font-size:13px;color:#3E3831}.ds-lodge__body{padding:16px}.ds-lodge dl{display:grid;grid-template-columns:72px 1fr;gap:6px 12px;margin:0;font-size:14.5px}.ds-lodge dt{color:#6B6258;font-size:13px}.ds-lodge dd{margin:0}.ds-todo{display:inline-block;padding:0 10px;border:1.5px dashed #A79F94;border-radius:99px;color:#6B6258;font-size:12px;line-height:1.75;font-weight:700}"
    },
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "整塊鋪當日深色的 sticky 頁首，換日時轉色。",
      "html": "<header class=\"ds-mast\"><b>熊本・阿蘇・由布院・別府</b><small>2026.11.24 – 12.01・8 日自駕</small></header>",
      "css": ".ds-mast{display:grid;gap:2px;padding:12px 16px;background:var(--day,#4F5E2C);color:#fff;transition:background-color .6s cubic-bezier(.16,1,.3,1)}.ds-mast b{font:900 22px/1.25 var(--round,\"Zen Maru\",sans-serif);letter-spacing:.02em}.ds-mast small{font-size:12.5px;opacity:.88}"
    },
    {
      "name": "Info Box",
      "kind": "card",
      "refersTo": "info-box",
      "description": "g-50 底、無框的資訊方塊。",
      "html": "<section class=\"ds-info\"><h3>11 月下旬天氣</h3><p class=\"ds-temp\"><b>12°</b><span>示意數值</span></p></section>",
      "css": ".ds-info{background:#FAF8F5;border-radius:16px;padding:16px}.ds-info h3{font:900 17px/1.3 var(--round,\"Zen Maru\",sans-serif);margin:0 0 8px}.ds-temp{display:flex;align-items:baseline;gap:8px;margin:0}.ds-temp b{font:900 34px/1 var(--round,\"Zen Maru\",sans-serif);color:var(--day,#4F5E2C);font-variant-numeric:tabular-nums}.ds-temp span{color:#6B6258;font-size:13px}"
    }
  ],
  "narrative": {
    "northStar": "紅葉前線",
